// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Child {
  id        String          @id @default(cuid())
  firstName String
  lastName  String
  birthDate DateTime        @db.Date
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  guardians ChildGuardian[]
  bookings  Booking[]
}

model User {
  id                            String                 @id @default(cuid())
  email                         String                 @unique
  emailVerifiedAt               DateTime?
  passwordHash                  String?
  phone                         String?
  fullName                      String
  avatarUrl                     String?
  roles                         UserRole[]             @default([PARENT])
  createdAt                     DateTime               @default(now())
  updatedAt                     DateTime               @updatedAt
  guardedChildren               ChildGuardian[]
  ownedLocations                Location[]
  accounts                      Account[]
  sessions                      Session[]
  caregiverProfile              CaregiverProfile?
  reviewedVerificationDocuments VerificationDocument[] @relation("VerificationDocumentReviewer")
  requestedBookings             Booking[]              @relation("BookingRequester")
  caregiverBookings             Booking[]              @relation("BookingCaregiver")
}

enum UserRole {
  PARENT
  CAREGIVER
  ADMIN
}

enum GuardianRelationship {
  MOTHER
  FATHER
  GUARDIAN
  OTHER
}

model ChildGuardian {
  id                String               @id @default(cuid())
  childId           String
  child             Child                @relation(fields: [childId], references: [id], onDelete: Cascade)
  userId            String
  user              User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  relationship      GuardianRelationship
  isPrimary         Boolean              @default(false)
  canBook           Boolean              @default(true)
  canApproveHandoff Boolean              @default(true)
  createdAt         DateTime             @default(now())

  @@unique([childId, userId])
  @@index([userId])
}

enum LocationType {
  HOME
  SCHOOL
  ACTIVITY
}

model Location {
  id               String       @id @default(cuid())
  type             LocationType
  name             String
  addressLine1     String
  addressLine2     String?
  city             String
  state            String
  postalCode       String
  latitude         Float?
  longitude        Float?
  // TODO: Derive this from coordinates during geocoding before supporting locations outside Central Time.
  timezone         String       @default("America/Chicago")
  ownerUserId      String?
  owner            User?        @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  isVerified       Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?
  pickupBookings   Booking[]    @relation("BookingPickupLocation")
  activityBookings Booking[]    @relation("BookingActivityLocation")
  dropoffBookings  Booking[]    @relation("BookingDropoffLocation")

  @@index([ownerUserId])
}

enum BookingStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

model Booking {
  id                   String        @id @default(cuid())
  childId              String
  child                Child         @relation(fields: [childId], references: [id], onDelete: Restrict)
  requestedByUserId    String
  requestedBy          User          @relation("BookingRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  caregiverUserId      String?
  caregiver            User?         @relation("BookingCaregiver", fields: [caregiverUserId], references: [id], onDelete: Restrict)
  status               BookingStatus @default(PENDING)
  scheduledPickupAt    DateTime      @db.Timestamptz(3)
  pickupLocationId     String
  pickupLocation       Location      @relation("BookingPickupLocation", fields: [pickupLocationId], references: [id], onDelete: Restrict)
  activityLocationId   String?
  activityLocation     Location?     @relation("BookingActivityLocation", fields: [activityLocationId], references: [id], onDelete: Restrict)
  dropoffLocationId    String
  dropoffLocation      Location      @relation("BookingDropoffLocation", fields: [dropoffLocationId], references: [id], onDelete: Restrict)
  estimatedDurationMin Int
  notes                String?
  expiresAt            DateTime      @db.Timestamptz(3)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([status, scheduledPickupAt])
  @@index([requestedByUserId, createdAt])
  @@index([childId, scheduledPickupAt])
  @@index([pickupLocationId])
  @@index([activityLocationId])
  @@index([dropoffLocationId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken String   @unique
  expires      DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime
  createdAt  DateTime @default(now())

  @@unique([identifier, token])
}

enum CaregiverStatus {
  PENDING_VERIFICATION
  VERIFIED
  SUSPENDED
}

model CaregiverProfile {
  id                    String                 @id @default(cuid())
  userId                String                 @unique
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio                   String?
  hourlyRateCents       Int
  vehicleMake           String?
  vehicleModel          String?
  vehicleYear           Int?
  vehicleColor          String?
  licensePlate          String?
  status                CaregiverStatus        @default(PENDING_VERIFICATION)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  verificationDocuments VerificationDocument[]

  @@index([status])
}

enum VerificationDocumentType {
  DRIVERS_LICENSE
  BACKGROUND_CHECK
  INSURANCE
}

enum VerificationDocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

model VerificationDocument {
  id                 String                     @id @default(cuid())
  caregiverProfileId String
  caregiverProfile   CaregiverProfile           @relation(fields: [caregiverProfileId], references: [id], onDelete: Cascade)
  type               VerificationDocumentType
  storageKey         String
  status             VerificationDocumentStatus @default(PENDING)
  reviewedByUserId   String?
  reviewedBy         User?                      @relation("VerificationDocumentReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt         DateTime?
  expiresAt          DateTime?
  createdAt          DateTime                   @default(now())

  @@index([caregiverProfileId])
  @@index([reviewedByUserId])
}
