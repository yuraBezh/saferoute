# Local development database (see docker-compose.yml)
DATABASE_URL="postgresql://saferoute:saferoute@localhost:5434/saferoute"

# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Canonical local origin used for OAuth callback URLs
AUTH_URL="http://localhost:3000"

# Google OAuth credentials (Google Cloud Console → Credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Seed data is attached to this account, so it shows up after you sign in.
# Use the email of the Google account you sign in with.
SEED_OWNER_EMAIL="mother@example.com"
