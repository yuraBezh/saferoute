{
  "name": "saferoute",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "prepare": "husky",
    "lint": "eslint",
    "format": "prettier --write .",
    "pretypecheck": "prisma generate && next typegen",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "db:e2e:up": "docker compose -f compose.e2e.yml up -d --wait",
    "db:e2e:reset": "dotenv --override -e .env.e2e -- node scripts/verify-e2e-database.mjs && dotenv --override -e .env.e2e -- prisma migrate reset --force",
    "test:e2e:prepare": "npm run db:e2e:up && npm run db:e2e:reset && dotenv --override -e .env.e2e -- npm run seed",
    "test:e2e": "npm run test:e2e:prepare && dotenv --override -e .env.e2e -- playwright test",
    "test:e2e:ui": "npm run test:e2e:prepare && dotenv --override -e .env.e2e -- playwright test --ui",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "next": "16.3.0",
    "pg": "^8.22.0",
    "prisma": "^7.9.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
